COMPOSE_PROJECT_NAME=deedims-prod
BACKEND_ENV_FILE=$HOME/.config/deedims/prod.backend.env
PUBLIC_ORIGIN=https://admin.deedims.biz.id
BACKEND_HOST_PORT=3100
# Port loopback untuk debug/health check; ganti kalau bentrok di host deploy.
FRONTEND_HOST_PORT=8080
DATA_VOLUME_NAME=deedims-prod-data
CLOUDFLARED_CONFIG_FILE=$HOME/apps/deedims-prod/deploy/cloudflared.prod.yml
CLOUDFLARED_CREDENTIALS_FILE=$HOME/.cloudflared/b5311bc4-b39a-4da0-ab79-4520e838b45e.json
# UID:GID pemilik CLOUDFLARED_CREDENTIALS_FILE di host deploy.
CLOUDFLARED_USER=1000:1000
